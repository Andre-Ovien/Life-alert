# Export explicitly in your shell. Never use this sample secret in deployment.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY=generate-a-private-secret
# Optional PostgreSQL; without POSTGRES_DB local SQLite is selected.
# POSTGRES_DB=lifealert
# POSTGRES_USER=lifealert
# POSTGRES_PASSWORD=set-locally
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
CONTINUE_ACCEPTED_INCIDENTS=1
# Development-only thresholds, not client-approved response promises.
LOCATION_MAX_AGE_SECONDS=300
LOCATION_MAX_ACCURACY_METERS=200
CREW_OFFER_SECONDS=120
SIMULATED_EMS_OUTCOME=acknowledged
# Use SIMULATED_EMS_OUTCOME=timeout to exercise unknown-provider outcomes.
