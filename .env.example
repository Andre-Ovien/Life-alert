# Export explicitly in your shell; this file is not automatically loaded.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY=generate-a-private-secret-of-at-least-50-characters
# Optional for local exploration; mandatory when DJANGO_DEBUG=0.
# POSTGRES_DB=lifealert
# POSTGRES_USER=lifealert
# POSTGRES_PASSWORD=set-locally
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
CONTINUE_ACCEPTED_INCIDENTS=1
# Local development location/offer thresholds, not approved service promises.
LOCATION_MAX_AGE_SECONDS=300
LOCATION_MAX_ACCURACY_METERS=200
CREW_OFFER_SECONDS=120
# No external requests; timeout preserves an unknown simulated EMS outcome.
SIMULATED_EMS_OUTCOME=acknowledged
SIM_NOTIFICATION_OUTCOME=success
SIM_NOTIFICATION_MAX_ATTEMPTS=3
SIM_NOTIFICATION_RETRY_SECONDS=5
SIM_NOTIFICATION_LEASE_SECONDS=60
# Configurable security lifetimes (seconds), independent of response targets.
CAREGIVER_INVITE_SECONDS=86400
ADULT_ACCESS_SECONDS=3600
ADULT_REFRESH_SECONDS=604800
ACCOUNT_CHALLENGE_SECONDS=1800
DEVICE_PAIRING_SECONDS=600
# Zero uses explicit revocation rather than timed child credential expiry.
DEVICE_TOKEN_SECONDS=0
STAFF_MFA_SECONDS=43200
STAFF_MFA_ENROLL_SECONDS=600
# DEBUG=0 also requires verified adult contact, staff MFA, PostgreSQL, explicit
# hosts, TLS, secure cookies, and the shared database cache table. Live contact
# delivery remains unavailable; see docs/BACKEND.md before any deployment.
